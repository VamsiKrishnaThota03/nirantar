# Copy to .env and fill in. Never commit .env.

# --- network ---------------------------------------------------------------
# Loopback by default. A container platform sets this to 0.0.0.0 in its own
# deployment config; do not do it here.
HOST=127.0.0.1
PORT=8000
# Named origins only, comma separated. Never a wildcard.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- data mode -------------------------------------------------------------
# true  = generated, fictional records; aggregate reads are anonymous.
# false = this process expects REAL person-level health records, and will
#         refuse to start unless the OIDC settings below are present.
DEMO_MODE=true
DATA_SEED=20260815
DB_PATH=./var/nirantar.sqlite3
LEDGER_KEY_PATH=./var/ledger_signing_key.pem

# --- agent reasoning (optional) -------------------------------------------
# Absent means the agents run on their deterministic cores, which is a
# supported mode rather than a degraded one.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
LLM_MAX_CALLS_PER_HOUR=400

# --- identity provider (required when DEMO_MODE=false) --------------------
# Nirantar mints no credentials of its own; it verifies tokens issued by the
# identity provider your organisation already runs. See SECURITY.md.
OIDC_ISSUER=
OIDC_AUDIENCE=
# Only if your provider does not publish the standard discovery path.
OIDC_JWKS_URL=
OIDC_ROLES_CLAIM=roles

# --- test escape hatch -----------------------------------------------------
# Purpose-named, defaults to deny, and refused outright when DEMO_MODE=false.
# Never set this in a deployment.
# NIRANTAR_AUTH_TEST_BYPASS=false
